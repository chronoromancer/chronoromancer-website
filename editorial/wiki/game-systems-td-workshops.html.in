</td><td data-label="军队经验">1575</td></tr><tr><th scope="row">6</th><td data-label="合金">285</td><td data-label="电路">57</td><td data-label="试剂">171</td><td data-label="助熔剂">57</td><td data-label="完好核心">7</td><td data-label="军队经验">2475</td></tr><tr><th scope="row">7</th><td data-label="合金">420</td><td data-label="电路">84</td><td data-label="试剂">252</td><td data-label="助熔剂">84</td><td data-label="完好核心">11</td><td data-label="军队经验">3825</td></tr><tr><th scope="row">8</th><td data-label="合金">600</td><td data-label="电路">120</td><td data-label="试剂">360</td><td data-label="助熔剂">120</td><td data-label="完好核心">16</td><td data-label="军队经验">5625</td></tr><tr><th scope="row">9</th><td data-label="合金">825</td><td data-label="电路">165</td><td data-label="试剂">495</td><td data-label="助熔剂">165</td><td data-label="完好核心">24</td><td data-label="军队经验">8100</td></tr><tr><th scope="row">10</th><td data-label="合金">1125</td><td data-label="电路">225</td><td data-label="试剂">675</td><td data-label="助熔剂">225</td><td data-label="完好核心">36</td><td data-label="军队经验">11250</td></tr></tbody></table></details><details><summary>炮塔控制</summary><table><thead><tr><th scope="col">目标等级</th><th scope="col">合金</th><th scope="col">电路</th><th scope="col">试剂</th><th scope="col">助熔剂</th><th scope="col">完好核心</th><th scope="col">军队经验</th></tr></thead><tbody><tr><th scope="row">2</th><td data-label="合金">18</td><td data-label="电路">45</td><td data-label="试剂">9</td><td data-label="助熔剂">18</td><td data-label="完好核心">0</td><td data-label="军队经验">225</td></tr><tr><th scope="row">3</th><td data-label="合金">30</td><td data-label="电路">75</td><td data-label="试剂">15</td><td data-label="助熔剂">30</td><td data-label="完好核心">0</td><td data-label="军队经验">450</td></tr><tr><th scope="row">4</th><td data-label="合金">48</td><td data-label="电路">120</td><td data-label="试剂">24</td><td data-label="助熔剂">48</td><td data-label="完好核心">2</td><td data-label="军队经验">900</td></tr><tr><th scope="row">5</th><td data-label="合金">75</td><td data-label="电路">188</td><td data-label="试剂">37</td><td data-label="助熔剂">75</td><td data-label="完好核心">4</td><td data-label="军队经验">1575</td></tr><tr><th scope="row">6</th><td data-label="合金">114</td><td data-label="电路">285</td><td data-label="试剂">57</td><td data-label="助熔剂">114</td><td data-label="完好核心">7</td><td data-label="军队经验">2475</td></tr><tr><th scope="row">7</th><td data-label="合金">168</td><td data-label="电路">420</td><td data-label="试剂">84</td><td data-label="助熔剂">168</td><td data-label="完好核心">11</td><td data-label="军队经验">3825</td></tr><tr><th scope="row">8</th><td data-label="合金">240</td><td data-label="电路">600</td><td data-label="试剂">120</td><td data-label="助熔剂">240</td><td data-label="完好核心">16</td><td data-label="军队经验">5625</td></tr><tr><th scope="row">9</th><td data-label="合金">330</td><td data-label="电路">825</td><td data-label="试剂">165</td><td data-label="助熔剂">330</td><td data-label="完好核心">24</td><td data-label="军队经验">8100</td></tr><tr><th scope="row">10</th><td data-label="合金">450</td><td data-label="电路">1125</td><td data-label="试剂">225</td><td data-label="助熔剂">450</td><td data-label="完好核心">36</td><td data-label="军队经验">11250</td></tr></tbody></table></details></details><figure class="reviewed-screenshot"><a aria-label="查看完整截图：AIMy与Tinker共用这四条控制升级。初始生命、屏障配额、屏障生命值与同时部署的炮塔数量分别生效。" href="../assets/images/wiki/td-workshops-guide/zh-control.webp" rel="noopener" target="_blank"><img alt="AIMy与Tinker共用这四条控制升级。初始生命、屏障配额、屏障生命值与同时部署的炮塔数量分别生效。" decoding="async" height="720" loading="lazy" src="../assets/images/wiki/td-workshops-guide/zh-control.webp" width="1280"/></a><figcaption>AIMy与Tinker共用这四条控制升级。初始生命、屏障配额、屏障生命值与同时部署的炮塔数量分别生效。</figcaption></figure></section>
<section id="zh-barriers"><span aria-hidden="true" class="wiki-anchor-alias" id="zh-Hero-Dependent_Barriers"></span><span aria-hidden="true" class="wiki-anchor-alias" id="zh-Regular_Barriers"></span><h2>Orchid：屏障的两条独立升级</h2><p>八种常规屏障各有“库存与生命”和“特殊效果”两条独立的 1–10 级研发。提高一条不会替另一条升级。基础每种六次；AIMy 提高基础次数，Orchid 的对应设计每级再加一次。最高每种 33 次，而不是全屏障合用 33 次。</p><p>次数用于整场战斗。被摧毁和进入新一波通常都不会补回；箱子的回收效果是特定例外。Orchid 每级另加基础生命的 20%，再乘 AIMy 的结构加固倍率，最后取整一次。两项都满级时为基础生命的 6.58 倍。</p><details><summary>八种屏障的基础值、价格和特殊效果</summary><p>战场价格按回收物／弹药／指挥列出。特殊效果的箭头表示效果研发从 1 级到 10 级的成长；中间等级线性变化。</p><table><thead><tr><th scope="col">屏障</th><th scope="col">基础生命</th><th scope="col">战场价格</th><th scope="col">特殊效果 1→10 级</th></tr></thead><tbody><tr><th scope="row">路障</th><td data-label="基础生命">180</td><td data-label="战场价格">20/0/3</td><td data-label="特殊效果 1→10 级">受到近战攻击时，有 10%→40% 概率使攻击者踉跄 0.15→0.60 秒；摧毁屏障的那一击也会判定。</td></tr><tr><th scope="row">箱子</th><td data-label="基础生命">140</td><td data-label="战场价格">16/0/2</td><td data-label="特殊效果 1→10 级">被摧毁时，有 5%→75% 概率恢复一次箱子部署次数；补放仍需支付战场资源。</td></tr><tr><th scope="row">围墙</th><td data-label="基础生命">320</td><td data-label="战场价格">32/0/5</td><td data-label="特殊效果 1→10 级">墙体自身受到的伤害降低 5%→35%。</td></tr><tr><th scope="row">沙袋</th><td data-label="基础生命">220</td><td data-label="战场价格">22/0/3</td><td data-label="特殊效果 1→10 级">在 100→150 像素范围内，使英雄受到的敌方远程伤害降低 10%→40%。</td></tr><tr><th scope="row">碎石堆</th><td data-label="基础生命">100</td><td data-label="战场价格">12/0/1</td><td data-label="特殊效果 1→10 级">在 100→150 像素范围内使敌人移动减慢 10%→40%。</td></tr><tr><th scope="row">加固箱</th><td data-label="基础生命">280</td><td data-label="战场价格">30/0/4</td><td data-label="特殊效果 1→10 级">每五个战斗秒恢复自身最大生命的 1%→5%。</td></tr><tr><th scope="row">奥术废料结界</th><td data-label="基础生命">200</td><td data-label="战场价格">26/8/6</td><td data-label="特殊效果 1→10 级">使 100→150 像素内的机械敌人对外伤害降低 10%→35%。</td></tr><tr><th scope="row">利刃废料路障</th><td data-label="基础生命">210</td><td data-label="战场价格">28/10/5</td><td data-label="特殊效果 1→10 级">反弹来袭近战攻击减伤前伤害的 10%→50%，包含摧毁屏障的攻击；反伤击杀获得军队经验。</td></tr></tbody></table></details><p>同种光环重叠时取最强效果，不把百分比相加；不同类型的保护可以同时作用。纳米修复信标修复炮塔和屏障，Orchid 修复屏障，Saline 治疗英雄；三者不能混用。</p><details><summary>各设计两条研发的完整费用</summary><p>同一设计的两条研发使用相同价格表，但要分别购买。</p><details><summary>路障</summary><table><thead><tr><th scope="col">目标等级</th><th scope="col">合金</th><th scope="col">电路</th><th scope="col">试剂</th><th scope="col">助熔剂</th><th scope="col">完好核心</th><th scope="col">军队经验</th></tr></thead><tbody><tr><th scope="row">2</th><td data-label="合金">84</td><td data-label="电路">12</td><td data-label="试剂">12</td><td data-label="助熔剂">12</td><td data-label="完好核心">0</td><td data-label="军队经验">150</td></tr><tr><th scope="row">3</th><td data-label="合金">140</td><td data-label="电路">20</td><td data-label="试剂">20</td><td data-label="助熔剂">20</td><td data-label="完好核心">0</td><td data-label="军队经验">300</td></tr><tr><th scope="row">4</th><td data-label="合金">224</td><td data-label="电路">32</td><td data-label="试剂">32</td><td data-label="助熔剂">32</td><td data-label="完好核心">4</td><td data-label="军队经验">600</td></tr><tr><th scope="row">5</th><td data-label="合金">350</td><td data-label="电路">50</td><td data-label="试剂">50</td><td data-label="助熔剂">50</td><td data-label="完好核心">8</td><td data-label="军队经验">1050</td></tr><tr><th scope="row">6</th><td data-label="合金">532</td><td data-label="电路">76</td><td data-label="试剂">76</td><td data-label="助熔剂">76</td><td data-label="完好核心">14</td><td data-label="军队经验">1650</td></tr><tr><th scope="row">7</th><td data-label="合金">784</td><td data-label="电路">112</td><td data-label="试剂">112</td><td data-label="助熔剂">112</td><td data-label="完好核心">22</td><td data-label="军队经验">2550</td></tr><tr><th scope="row">8</th><td data-label="合金">1120</td><td data-label="电路">160</td><td data-label="试剂">160</td><td data-label="助熔剂">160</td><td data-label="完好核心">32</td><td data-label="军队经验">3750</td></tr><tr><th scope="row">9</th><td data-label="合金">1540</td><td data-label="电路">220</td><td data-label="试剂">220</td><td data-label="助熔剂">220</td><td data-lab