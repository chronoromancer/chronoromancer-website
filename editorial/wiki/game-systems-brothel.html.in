td data-label="MAX金币">$256,000</td><td data-label="MAX布料">456/274/182</td></tr><tr><th scope="row">42</th><td data-label="普通金币">$148,900</td><td data-label="普通布料">231/139/92</td><td data-label="MAX金币">$297,800</td><td data-label="MAX布料">462/278/184</td></tr><tr><th scope="row">43</th><td data-label="普通金币">$173,300</td><td data-label="普通布料">234/141/93</td><td data-label="MAX金币">$346,600</td><td data-label="MAX布料">468/282/186</td></tr><tr><th scope="row">44</th><td data-label="普通金币">$201,600</td><td data-label="普通布料">237/143/94</td><td data-label="MAX金币">$403,200</td><td data-label="MAX布料">474/286/188</td></tr><tr><th scope="row">45</th><td data-label="普通金币">$234,500</td><td data-label="普通布料">240/145/95</td><td data-label="MAX金币">$469,000</td><td data-label="MAX布料">480/290/190</td></tr><tr><th scope="row">46</th><td data-label="普通金币">$272,900</td><td data-label="普通布料">242/146/96</td><td data-label="MAX金币">$545,800</td><td data-label="MAX布料">484/292/192</td></tr><tr><th scope="row">47</th><td data-label="普通金币">$317,500</td><td data-label="普通布料">244/147/97</td><td data-label="MAX金币">$635,000</td><td data-label="MAX布料">488/294/194</td></tr><tr><th scope="row">48</th><td data-label="普通金币">$369,400</td><td data-label="普通布料">246/148/98</td><td data-label="MAX金币">$738,800</td><td data-label="MAX布料">492/296/196</td></tr><tr><th scope="row">49</th><td data-label="普通金币">$429,800</td><td data-label="普通布料">248/149/99</td><td data-label="MAX金币">$859,600</td><td data-label="MAX布料">496/298/198</td></tr><tr><th scope="row">50</th><td data-label="普通金币">$500,000</td><td data-label="普通布料">250/150/99</td><td data-label="MAX金币">$1,000,000</td><td data-label="MAX布料">500/300/198</td></tr></tbody></table></div></details>
