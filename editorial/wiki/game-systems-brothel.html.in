tr><tr><th scope="row">40</th><td data-label="Ordinary gold">$110, 000</td><td data-label="Ordinary fabrics">225/135/90</td><td data-label="MAX gold">$220, 000</td><td data-label="MAX fabrics">450/270/180</td></tr><tr><th scope="row">41</th><td data-label="Ordinary gold">$128, 000</td><td data-label="Ordinary fabrics">228/137/91</td><td data-label="MAX gold">$256, 000</td><td data-label="MAX fabrics">456/274/182</td></tr><tr><th scope="row">42</th><td data-label="Ordinary gold">$148, 900</td><td data-label="Ordinary fabrics">231/139/92</td><td data-label="MAX gold">$297, 800</td><td data-label="MAX fabrics">462/278/184</td></tr><tr><th scope="row">43</th><td data-label="Ordinary gold">$173, 300</td><td data-label="Ordinary fabrics">234/141/93</td><td data-label="MAX gold">$346, 600</td><td data-label="MAX fabrics">468/282/186</td></tr><tr><th scope="row">44</th><td data-label="Ordinary gold">$201, 600</td><td data-label="Ordinary fabrics">237/143/94</td><td data-label="MAX gold">$403, 200</td><td data-label="MAX fabrics">474/286/188</td></tr><tr><th scope="row">45</th><td data-label="Ordinary gold">$234, 500</td><td data-label="Ordinary fabrics">240/145/95</td><td data-label="MAX gold">$469, 000</td><td data-label="MAX fabrics">480/290/190</td></tr><tr><th scope="row">46</th><td data-label="Ordinary gold">$272, 900</td><td data-label="Ordinary fabrics">242/146/96</td><td data-label="MAX gold">$545, 800</td><td data-label="MAX fabrics">484/292/192</td></tr><tr><th scope="row">47</th><td data-label="Ordinary gold">$317, 500</td><td data-label="Ordinary fabrics">244/147/97</td><td data-label="MAX gold">$635, 000</td><td data-label="MAX fabrics">488/294/194</td></tr><tr><th scope="row">48</th><td data-label="Ordinary gold">$369, 400</td><td data-label="Ordinary fabrics">246/148/98</td><td data-label="MAX gold">$738, 800</td><td data-label="MAX fabrics">492/296/196</td></tr><tr><th scope="row">49</th><td data-label="Ordinary gold">$429, 800</td><td data-label="Ordinary fabrics">248/149/99</td><td data-label="MAX gold">$859, 600</td><td data-label="MAX fabrics">496/298/198</td></tr><tr><th scope="row">50</th><td data-label="Ordinary gold">$500, 000</td><td data-label="Ordinary fabrics">250/150/99</td><td data-label="MAX gold">$1, 000, 000</td><td data-label="MAX fabrics">500/300/198</td></tr></tbody></table></div></details>
